{% doc %}
  @prompt
    In the Guarantee Badges block on the product page, add a line that displays the text "✓ Veilig en snel betalen met iDeal" with the official iDEAL payment logo displayed on the right side of the text. The logo should be inline with the text and appropriately sized to match the text height. Style it to look clean and trustworthy, consistent with a guarantee badge style.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-guarantee-badges-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-guarantee-badges__list-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.item_spacing }}px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ai-guarantee-badges__item-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: {{ block.settings.icon_text_gap }}px;
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.font_size }}px;
    line-height: 1.4;
  }

  .ai-guarantee-badges__icon-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    color: {{ block.settings.icon_color }};
  }

  .ai-guarantee-badges__text-{{ ai_gen_id }} {
    flex-grow: 1;
  }

  .ai-guarantee-badges__payment-logo-{{ ai_gen_id }} {
    flex-shrink: 0;
    height: {{ block.settings.font_size }}px;
    width: auto;
    margin-left: {{ block.settings.icon_text_gap }}px;
  }

  @media screen and (max-width: 749px) {
    .ai-guarantee-badges-{{ ai_gen_id }} {
      width: 100%;
    }
  }
{% endstyle %}

<div class="ai-guarantee-badges-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <ul class="ai-guarantee-badges__list-{{ ai_gen_id }}">
    {% if block.settings.show_badge_1 and block.settings.badge_1_text != blank %}
      <li class="ai-guarantee-badges__item-{{ ai_gen_id }}">
        <svg class="ai-guarantee-badges__icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
        <span class="ai-guarantee-badges__text-{{ ai_gen_id }}">{{ block.settings.badge_1_text }}</span>
      </li>
    {% endif %}

    {% if block.settings.show_badge_2 and block.settings.badge_2_text != blank %}
      <li class="ai-guarantee-badges__item-{{ ai_gen_id }}">
        <svg class="ai-guarantee-badges__icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
        <span class="ai-guarantee-badges__text-{{ ai_gen_id }}">{{ block.settings.badge_2_text }}</span>
      </li>
    {% endif %}

    {% if block.settings.show_badge_3 and block.settings.badge_3_text != blank %}
      <li class="ai-guarantee-badges__item-{{ ai_gen_id }}">
        <svg class="ai-guarantee-badges__icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
        <span class="ai-guarantee-badges__text-{{ ai_gen_id }}">{{ block.settings.badge_3_text }}</span>
      </li>
    {% endif %}

    {% if block.settings.show_ideal_badge %}
      <li class="ai-guarantee-badges__item-{{ ai_gen_id }}">
        <svg class="ai-guarantee-badges__icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
        <span class="ai-guarantee-badges__text-{{ ai_gen_id }}">{{ block.settings.ideal_text }}</span>
        <svg class="ai-guarantee-badges__payment-logo-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 80 32" fill="none">
          <rect width="80" height="32" rx="4" fill="#CC0066"/>
          <path d="M12 8h3v16h-3V8z" fill="white"/>
          <path d="M18 8h6c3.31 0 6 2.69 6 6v4c0 3.31-2.69 6-6 6h-6V8zm3 3v10h3c1.66 0 3-1.34 3-3v-4c0-1.66-1.34-3-3-3h-3z" fill="white"/>
          <path d="M33 8h9v3h-6v3h5v3h-5v4h6v3h-9V8z" fill="white"/>
          <path d="M48 8h3l5 16h-3l-1-3h-5l-1 3h-3l5-16zm2.5 10l-1.5-5-1.5 5h3z" fill="white"/>
          <path d="M59 8h3v13h6v3h-9V8z" fill="white"/>
        </svg>
      </li>
    {% endif %}

    {% if block.settings.show_badge_4 and block.settings.badge_4_text != blank %}
      <li class="ai-guarantee-badges__item-{{ ai_gen_id }}">
        <svg class="ai-guarantee-badges__icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
        <span class="ai-guarantee-badges__text-{{ ai_gen_id }}">{{ block.settings.badge_4_text }}</span>
      </li>
    {% endif %}

    {% if block.settings.show_badge_5 and block.settings.badge_5_text != blank %}
      <li class="ai-guarantee-badges__item-{{ ai_gen_id }}">
        <svg class="ai-guarantee-badges__icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
        <span class="ai-guarantee-badges__text-{{ ai_gen_id }}">{{ block.settings.badge_5_text }}</span>
      </li>
    {% endif %}
  </ul>
</div>

{% schema %}
{
  "name": "Guarantee badges",
  "settings": [
    {
      "type": "header",
      "content": "Badge 1"
    },
    {
      "type": "checkbox",
      "id": "show_badge_1",
      "label": "Show badge 1",
      "default": true
    },
    {
      "type": "text",
      "id": "badge_1_text",
      "label": "Badge 1 text",
      "default": "30 dagen niet goed, geld terug"
    },
    {
      "type": "header",
      "content": "Badge 2"
    },
    {
      "type": "checkbox",
      "id": "show_badge_2",
      "label": "Show badge 2",
      "default": true
    },
    {
      "type": "text",
      "id": "badge_2_text",
      "label": "Badge 2 text",
      "default": "Gratis verzending vanaf €50"
    },
    {
      "type": "header",
      "content": "Badge 3"
    },
    {
      "type": "checkbox",
      "id": "show_badge_3",
      "label": "Show badge 3",
      "default": true
    },
    {
      "type": "text",
      "id": "badge_3_text",
      "label": "Badge 3 text",
      "default": "Vandaag besteld, morgen in huis"
    },
    {
      "type": "header",
      "content": "iDEAL payment badge"
    },
    {
      "type": "checkbox",
      "id": "show_ideal_badge",
      "label": "Show iDEAL badge",
      "default": true
    },
    {
      "type": "text",
      "id": "ideal_text",
      "label": "iDEAL badge text",
      "default": "Veilig en snel betalen met iDeal"
    },
    {
      "type": "header",
      "content": "Badge 4"
    },
    {
      "type": "checkbox",
      "id": "show_badge_4",
      "label": "Show badge 4",
      "default": false
    },
    {
      "type": "text",
      "id": "badge_4_text",
      "label": "Badge 4 text"
    },
    {
      "type": "header",
      "content": "Badge 5"
    },
    {
      "type": "checkbox",
      "id": "show_badge_5",
      "label": "Show badge 5",
      "default": false
    },
    {
      "type": "text",
      "id": "badge_5_text",
      "label": "Badge 5 text"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#f8f8f8"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "default": "#008060"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 12,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "icon_text_gap",
      "label": "Icon to text spacing",
      "min": 4,
      "max": 20,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "item_spacing",
      "label": "Space between badges",
      "min": 4,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_vertical",
      "label": "Vertical padding",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "label": "Horizontal padding",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "Guarantee badges"
    }
  ]
}
{% endschema %}